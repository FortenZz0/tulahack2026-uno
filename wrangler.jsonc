{
  "name": "tulahack2026-uno",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",

  // обновление каждые 10 минут
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // храним ответ NASA
  "r2_buckets": [
    {
      "binding": "PLANETS_BUCKET",
      "bucket_name": "tulahack-planets"
    }
  ]
}